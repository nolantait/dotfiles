{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": ["opencode"],
  "agent": {
    "coder": {
      "prompt": "{file:./prompts/system.md}"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "formatter": false,
  "lsp": true,
  "share": "disabled",
  "permission": {
    "webfetch": "ask",
    "websearch": "ask",

    "edit": "allow",
    "question": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "skill": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "lsp": "allow",

    "bash": {
      "*": "ask",
      "bin/packs *": "allow",
      "bin/packwerk *": "allow",
      "bin/rails *": "allow",
      "bin/rspec *": "allow",
      "bin/rubocop *": "allow",
      "basename *": "allow",
      "bundle *": "allow",
      "cargo *": "allow",
      "cat *": "allow",
      "cp *": "allow",
      "cut *": "allow",
      "echo *": "allow",
      "find *": "allow",
      "gem *": "allow",
      "git branch *": "allow",
      "git mv *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git status *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "ls *": "allow",
      "mkdir *": "allow",
      "pnpm *": "allow",
      "printf *": "allow",
      "rails *": "allow",
      "rg *": "allow",
      "rspec *": "allow",
      "ruby *": "allow",
      "sed *": "allow",
      "sort *": "allow",
      "tail *": "allow",
      "timeout *": "allow",
      "tr *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "xargs *": "allow"
    },

    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },

    "external_directory": {
      "~/.local/share/mise/*": "allow"
    }
  }
}
